# Copy to .env.local and fill in. Never commit .env.local.

# Canonical site origin (metadataBase, sitemap, OG).
NEXT_PUBLIC_SITE_URL=

# Supabase project URL, e.g. https://xxxx.supabase.co (also enables next/image remote pattern).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key — server only (contact RPC, seed). Never expose.
SUPABASE_SECRET_KEY=

# Email of the single admin user (seeded into `admins`).
ADMIN_EMAIL=
# Shared secret for /api/revalidate.
REVALIDATE_SECRET=
# Optional: Google Search Console HTML-tag verification token (content of the meta tag).
GOOGLE_SITE_VERIFICATION=
